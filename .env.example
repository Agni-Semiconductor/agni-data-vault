# Agni Data Vault environment. See docs/CONTRACT.md "Contract v2" for the full contract.
#
# NOTHING here may start with VITE_ except VITE_API_BASE_URL, which is not a credential.
# Anything VITE_-prefixed is inlined into the browser bundle at build time. Since the
# browser no longer talks to the database at all (contract v2.7), "there are no secret
# VITE_ vars" is a greppable invariant, not a convention to remember.

# ---------------------------------------------------------------------------
# Client (Vite) -- built into the SPA, publicly visible
# ---------------------------------------------------------------------------
# Origin the SPA calls for /api. Same-origin in production (Cloudflare fronts both the
# Vercel-hosted SPA and the tunnelled API under one hostname), so leave it empty there;
# set it only for local dev against a remote API.
VITE_API_BASE_URL=

# ---------------------------------------------------------------------------
# Server (vault-api on edaserver) -- /etc/vault/vault-api.env, mode 0640 root:vaultsvc
# ---------------------------------------------------------------------------
# PostgREST origin. Loopback only: this is the nginx compatibility origin that fronts
# PostgREST :3000 and the object store :3001. It is never published through the tunnel --
# the JWT below bypasses row-level security on every table. The /rest/v1 path is required;
# omitting it makes metadata calls hit the wrong route and look like missing tables.
VAULT_REST_URL=http://127.0.0.1:8087/rest/v1
# The /storage/v1 path is required; omitting it makes object requests hit the wrong route and
# look like missing files.
VAULT_STORAGE_URL=http://127.0.0.1:8087/storage/v1

# HS256, role=vault_service. Mint with `tools/mint_service_jwt.py --role vault_service`
# from the ferrodiode-pcb-testbench repo. Must be signed with the SAME secret as
# PGRST_JWT_SECRET. Never regenerate that shared secret: metadata reads can succeed while file
# downloads return 401, which reads as a corrupt archive rather than a changed signing secret.
VAULT_SERVICE_JWT=

# Shared static key for machine clients (agents, cli/vault.py, cli/backfill.py). Also the
# break-glass path: it keeps working when the identity provider is down, which is why no
# second password is needed anywhere. Without it, machine requests return 500/401, which reads
# as an API outage instead of a missing server credential.
VAULT_API_KEY=

# Cloudflare Access -- Google Workspace SSO for human requests (contract v2.3).
# The JWT in Cf-Access-Jwt-Assertion is verified against the team's JWKS and the aud
# below. Without the team URL, assertions cannot be verified and browser requests return 401,
# which reads as a failed Google login.
VAULT_ACCESS_TEAM_URL=https://<team>.cloudflareaccess.com
VAULT_ACCESS_AUD=
# The audience is checked in every assertion. Without it, browser requests return 401, which
# reads as an account or Workspace problem.
# Both the email domain AND Google's `hd` claim must equal this. `hd` is asserted by
# Google about the account's domain and cannot be spoofed by an alias; an email-suffix
# check alone can be satisfied by a personal account. Without it, human identity is rejected and
# browser requests return 401, which reads as an Access policy rejection.
VAULT_EMAIL_DOMAIN=agnisemi.ai
# Search agent (E6). Without it /api/search/ask returns 503 agent_unavailable while other routes
# work, which reads as a search-route failure rather than a server-wide outage.
#
# SERVER-SIDE ONLY. There is deliberately no VITE_ variable: exposing this key would put it in
# browser code, which reads as a configured search agent until the key is abused.
ANTHROPIC_API_KEY=

# Port for server/vault-api.mjs. Without 8099 the configured proxy route cannot reach the API;
# using 3001 collides with the object store and reads as a proxy or storage failure.
PORT=8099
