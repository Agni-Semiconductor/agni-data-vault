# Agni Data Vault environment. See docs/CONTRACT.md "Contract v2" for the full contract.
#
# NOTHING here may start with VITE_ except VITE_API_BASE_URL, which is not a credential.
# Anything VITE_-prefixed is inlined into the browser bundle at build time. Since the
# browser no longer talks to the database at all (contract v2.7), "there are no secret
# VITE_ vars" is a greppable invariant, not a convention to remember.

# ---------------------------------------------------------------------------
# Client (Vite) -- built into the SPA, publicly visible
# ---------------------------------------------------------------------------
# Origin the SPA calls for /api. Same-origin in production (Cloudflare fronts both the
# Vercel-hosted SPA and the tunnelled API under one hostname), so leave it empty there;
# set it only for local dev against a remote API.
VITE_API_BASE_URL=

# ---------------------------------------------------------------------------
# Server (vault-api on edaserver) -- /etc/vault/vault-api.env, mode 0640 root:vaultsvc
# ---------------------------------------------------------------------------
# PostgREST origin. Loopback only: this is the nginx compatibility origin that fronts
# PostgREST :3000 and the object store :3001. It is never published through the tunnel --
# the JWT below bypasses row-level security on every table.
VAULT_REST_URL=http://127.0.0.1:8087
VAULT_STORAGE_URL=http://127.0.0.1:8087

# HS256, role=vault_service. Mint with `tools/mint_service_jwt.py --role vault_service`
# from the ferrodiode-pcb-testbench repo. Must be signed with the SAME secret as
# PGRST_JWT_SECRET, or metadata reads succeed while file downloads 401 -- which reads as
# "the store is corrupt" rather than "the secret is wrong".
VAULT_SERVICE_JWT=

# Shared static key for machine clients (agents, cli/vault.py, cli/backfill.py). Also the
# break-glass path: it keeps working when the identity provider is down, which is why no
# second password is needed anywhere. Generate once:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
VAULT_API_KEY=

# Cloudflare Access -- Google Workspace SSO for human requests (contract v2.3).
# The JWT in Cf-Access-Jwt-Assertion is verified against the team's JWKS and the aud
# below. It is never trusted as a bare header.
VAULT_ACCESS_TEAM_URL=https://<team>.cloudflareaccess.com
VAULT_ACCESS_AUD=
# Both the email domain AND Google's `hd` claim must equal this. `hd` is asserted by
# Google about the account's domain and cannot be spoofed by an alias; an email-suffix
# check alone can be satisfied by a personal account.
VAULT_EMAIL_DOMAIN=agnisemi.ai
# Seeds the first admin row in vault.people so you are not locked out of the admin pages.
VAULT_ADMIN_BOOTSTRAP=

# Set to 1 to reject POST/PATCH/DELETE. Used for the phase-2 shakedown deploy, where the
# new stack is compared side by side against the live hosted site before any write lands.
# --- The search agent (E6). OPTIONAL: without it /api/search/ask returns 503
# agent_unavailable and every other route works normally. An unconfigured optional feature is a
# deployment state, not a fault.
#
# SERVER-SIDE ONLY. There is deliberately no VITE_ variable for this -- the browser never talks
# to Anthropic, and a CI check asserts the SDK is absent from every bundle chunk.
ANTHROPIC_API_KEY=

VAULT_READONLY=

# Port for server/vault-api.mjs. Do NOT use 3001 -- the object store owns that port on
# the same host.
PORT=8099
