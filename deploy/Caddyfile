{
	# NO PORT 80. Caddy binds :80 by default to serve HTTP->HTTPS redirects, and nginx already
	# holds it on this box. The failure is
	#     listening on :80: listen tcp :80: bind: address already in use
	# which names a port this file never mentions, so it reads as a conflict on 443. Nothing here
	# should be reachable over plain HTTP anyway: there is no request this door serves that is
	# acceptable unencrypted, so a redirect is not a courtesy worth a listener.
	#
	# `disable_redirects`, NOT `auto_https off`. Turning auto_https off would also disable
	# certificate management, and Caddy's own log line ("skipping automatic certificate management
	# because one or more matching certificates are already loaded") shows it is already doing the
	# right thing with the certificate `tailscale cert` wrote.
	auto_https disable_redirects
}

edaserver.<tailnet>.ts.net {
	# THE TAILNET INTERFACE ONLY. Without this Caddy listens on 0.0.0.0:443, and this host sits on
	# three other networks besides the tailnet (a lab LAN, a management LAN and wifi). Binding
	# everywhere would publish the data plane to all of them, which is not what "the tailnet door"
	# means and is not what the runbooks claim happens.
	#
	# Substituted at install time from `tailscale ip -4` and `-6`, because the address is a
	# per-host fact and a hardcoded one silently deploys the wrong thing on the next box.
	bind <tailscale_bind>
	tls <tailscale_cert_path> <tailscale_key_path>
	encode zstd gzip
	log {
		output file /var/log/caddy/vault-access.log
	}
	route {
		request_header -Cf-Access-Jwt-Assertion
		request_header -X-Vault-*

		# /rest/v1 and /storage/v1 are NEVER published through the Cloudflare tunnel: the token they carry bypasses row-level security on every table, so there is no version of exposing them beyond the tailnet that is safe.
		# Use handle, not handle_path: nginx expects the full /rest/v1/... and /storage/v1/... paths and strips once with trailing-slash proxy_pass; stripping here too makes PostgREST return 404 for tables that exist.
		handle /rest/v1/* {
			reverse_proxy 127.0.0.1:8087
		}

		handle /storage/v1/* {
			reverse_proxy 127.0.0.1:8087
		}

		# A REAL check, not a bare 200. The loudest silent failure in this stack is a service
		# role provisioned without BYPASSRLS: PostgREST then returns [] for every table, the API
		# reports success, and the vault looks empty rather than unauthorised. So /healthz must
		# read a row it knows exists -- vault-api implements that; this only routes it.
		handle /healthz {
			reverse_proxy 127.0.0.1:8099
		}

		handle /api/* {
			request_body {
				max_size 200MB
			}
			reverse_proxy 127.0.0.1:8099
		}
		# Anything else on the tailnet door is not a thing. Without this, a request matching no
		# handle above falls through the route with no handler and Caddy answers an empty 200.
		handle {
			respond 404
		}
	}
}
