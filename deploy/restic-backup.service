# Restic backup to the Synology NAS -- INSTALLED on edaserver 2026-09-16 by vault-volume-install.sh.
#
# HISTORY. Commit 5470810 (2026-09-15) added this unit describing its changes as already made; none
# had landed on the box. Owen showed the live unit on 2026-09-16, authorized the replacement, and
# step 7 installed it at 09:58 that day, saving the previous unit as
# /etc/systemd/system/restic-backup.service.bak.20260916T095835. The unit it replaced, verbatim
# (the two lines the pager cut were later captured in full by the installer: the tag was
# `scheduled`, the policy `--keep-hourly 24 --keep-daily 14 --keep-weekly 8 --keep-monthly 12`):
#
#   [Unit]
#   Description=Restic backup to Synology NAS
#   Requires=mnt-nasbackup.mount
#   After=mnt-nasbackup.mount
#
#   [Service]
#   Type=oneshot
#   Environment=RESTIC_CACHE_DIR=/var/cache/restic
#   EnvironmentFile=/etc/restic/backup.env
#   ExecStart=/usr/bin/restic backup /storage /srv/nextcloud --exclude-caches --tag sc>
#   ExecStartPost=/usr/bin/restic forget --keep-hourly 24 --keep-daily 14 --keep-weekl>
#   Nice=10
#   IOSchedulingClass=idle
#
# Before the replacement: /storage and ALL of /srv/nextcloud went off-host; /srv/fedbench (the pg_dump
# pair and the live object store, on the boot mirror) did NOT. The prune ran as ExecStartPost, so a
# prune failure reported as a backup failure. There was no OnFailure alert. Whether the unit had in
# fact been failing that way is still UNVERIFIED: journalctl -u restic-backup.service.
#
# Restic is managed by Owen. He authorized this file to replace the live unit on 2026-09-16
# ("confirmed good by me"). Step 7 saved the live unit with a timestamp, copied the live retention
# policy into restic-prune.service and the live snapshot tag into this ExecStart, and kept OnFailure
# because fedbench-alert@.service was present. The four differences from the previous unit:
#
#   1. ADD /srv/fedbench/backups. The nightly pg_dump pair is the only artifact that has actually
#      been restored and verified, and it currently has no off-host copy. Highest value of the four.
#      After relocate-fedbench-data.sh the path is a bind mount of a directory under /storage that
#      restic already sees; listing it explicitly costs nothing (dedup) and keeps the backup correct
#      whether or not the relocation has happened.
#   2. ADD --exclude=/storage/vault.img. The 512 GiB preallocated image vault-volume-install.sh
#      loop-mounts at /storage/vault. Restic descends into mount points, so the FILES on it are
#      already covered by way of /storage; the image itself is a nightly 512 GiB read to store a torn
#      copy of the same bytes as one blob.
#   3. MOVE the prune out of ExecStartPost into restic-prune.service on its own weekly timer, so a
#      prune problem cannot mask a backup result and the two never contend for the repository lock.
#      The retention flags in that unit must be copied from the live line once it is seen in full.
#   4. ADD OnFailure=fedbench-alert@%n.service -- only if that template is installed on the box
#      (alerting-install.sh); otherwise systemd logs a failed enqueue and the alert never fires.
#
# KEPT AS LIVE, deliberately: /srv/nextcloud in full. The earlier repo copy narrowed it to
# /srv/nextcloud/fedbench, which would have silently DROPPED the rest of that disk from the backup.
#
# Undo: cp /etc/systemd/system/restic-backup.service.bak.<stamp> back over the unit,
# systemctl daemon-reload, systemctl disable --now restic-prune.timer.

[Unit]
Description=Restic backup to Synology NAS
# Requires=, not Wants=: with the NAS unmounted the unit must FAIL rather than run, or restic creates
# a repository inside the empty mountpoint on the root disk and reports success.
Requires=mnt-nasbackup.mount
After=mnt-nasbackup.mount
# (4) -- fedbench-alert@.service was present at install time, so this stayed.
OnFailure=fedbench-alert@%n.service

[Service]
Type=oneshot
Environment=RESTIC_CACHE_DIR=/var/cache/restic
EnvironmentFile=/etc/restic/backup.env
# (1) adds /srv/fedbench/backups; (2) adds the exclude. /storage and /srv/nextcloud are as live.
# DELIBERATELY NOT INCLUDED: /var/lib/pgsql/17/data. A file-level copy of a running cluster is torn.
ExecStart=/usr/bin/restic backup /storage /srv/nextcloud /srv/fedbench/backups --exclude=/storage/vault.img --exclude-caches --tag scheduled
# (3) -- the live ExecStartPost=/usr/bin/restic forget ... --prune moves to restic-prune.service.
Nice=10
IOSchedulingClass=idle
