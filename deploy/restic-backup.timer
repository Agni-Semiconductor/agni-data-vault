# Companion timer for restic-backup.service. THIS is the unit you enable.
#
# ADOPTED UNCHANGED. Every directive below is exactly what is already running on edaserver; it is
# here so the repo holds the whole picture rather than half of it -- the service was being changed
# and its schedule lived only on the box, which is the same drift this project has been closing
# everywhere else.
#
# Three times a day is a deliberate choice for /storage, which is live working data. It stays.

[Unit]
Description=Restic backup every 8 hours (04:00, 12:00, 20:00)

[Timer]
OnCalendar=*-*-* 04/8:00:00
RandomizedDelaySec=15m
Persistent=true

[Install]
WantedBy=timers.target
